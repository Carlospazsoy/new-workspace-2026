{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$roomId": {
        ".read": "auth != null && data.child('players').child(auth.uid).exists()",
        ".write": "auth != null && !data.exists() && newData.child('hostUid').val() === auth.uid && newData.child('players').child(auth.uid).exists()",
        "hostUid": {
          ".read": "auth != null",
          ".validate": "newData.isString()"
        },
        "status": {
          ".read": "auth != null",
          ".write": "auth != null && root.child('rooms').child($roomId).child('hostUid').val() === auth.uid && (newData.val() === 'playing' || newData.val() === 'closed')",
          ".validate": "newData.isString() && (newData.val() === 'lobby' || newData.val() === 'playing' || newData.val() === 'closed')"
        },
        "questionIndex": {
          ".read": "auth != null",
          ".write": "auth != null && root.child('rooms').child($roomId).child('hostUid').val() === auth.uid",
          ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 5"
        },
        "createdAt": {
          ".validate": "newData.isNumber()"
        },
        "players": {
          "$uid": {
            ".read": "auth != null && (auth.uid === $uid || root.child('rooms').child($roomId).child('players').child(auth.uid).exists())",
            ".write": "auth != null && auth.uid === $uid && root.child('rooms').child($roomId).child('hostUid').exists() && (!newData.exists() || (root.child('rooms').child($roomId).child('status').val() === 'lobby' || root.child('rooms').child($roomId).child('status').val() === 'playing') && (data.exists() || root.child('rooms').child($roomId).child('status').val() === 'lobby'))",
            ".validate": "newData.hasChildren(['name', 'score', 'questionIndex', 'finished'])",
            "name": {
              ".validate": "newData.isString() && newData.val().length > 0 && newData.val().length <= 24"
            },
            "score": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 5"
            },
            "questionIndex": {
              ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 5"
            },
            "finished": {
              ".validate": "newData.isBoolean()"
            }
          }
        }
      }
    }
  }
}
